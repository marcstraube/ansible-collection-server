{{ ansible_managed | comment }}

<VirtualHost {{ item.listen_address | default('*') }}:{{ item.listen_port | default(443) }}>
    ServerName {{ item.server_name }}
{% if item.server_alias is defined %}
{% for alias in item.server_alias %}
    ServerAlias {{ alias }}
{% endfor %}

{% endif %}
{% if item.document_root is defined %}
    DocumentRoot {{ item.document_root }}

    <Directory {{ item.document_root }}>
        Options {{ item.options | default('-Indexes +FollowSymLinks') }}
        AllowOverride {{ item.allow_override | default('None') }}
        Require all granted
    </Directory>

{% endif %}
    # SSL Configuration
    SSLEngine on
    SSLCertificateFile {{ item.certificate_file }}
    SSLCertificateKeyFile {{ item.certificate_key_file }}
{% if item.certificate_chain_file is defined and item.certificate_chain_file %}
    SSLCertificateChainFile {{ item.certificate_chain_file }}

{% endif %}
    # Modern SSL configuration
    SSLProtocol {{ item.ssl_protocol | default(apache_ssl_protocol) }}
    SSLCipherSuite {{ item.ssl_cipher_suite | default(apache_ssl_cipher_suite) }}
    SSLHonorCipherOrder {{ 'on' if (item.ssl_honor_cipher_order | default(apache_ssl_honor_cipher_order)) else 'off' }}

    # Security headers are set globally in security.conf

{% if apache_http2_enabled %}
    # HTTP/2
    Protocols h2 http/1.1

{% endif %}
{% include 'vhost_php_fpm.conf.j2' %}
    # Logging
    ErrorLog {{ __apache_log_dir }}/{{ item.server_name }}-ssl-error.log
    CustomLog {{ __apache_log_dir }}/{{ item.server_name }}-ssl-access.log combined

{% if item.custom_config is defined %}
    # Custom configuration
    {{ item.custom_config | indent(4) }}
{% endif %}
</VirtualHost>
