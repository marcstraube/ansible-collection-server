{# PHP-FPM handler of a single vhost, included by vhost.conf.j2 and
   vhost_ssl.conf.j2. With apache_php_fpm_scope 'vhost' every vhost gets its
   own handler; with 'global' only a vhost that sets php_fpm_socket or
   php_fpm_timeout overrides the server-wide one. #}
{% if apache_php_fpm_enabled | default(false) %}
{% set __apache_fpm_global = apache_php_fpm_scope | default('vhost') == 'global' %}
{% if not __apache_fpm_global or item.php_fpm_socket is defined %}
    # PHP-FPM proxy
{% set __apache_fpm_raw = item.php_fpm_socket | default(apache_php_fpm_socket) %}
{# Same rule as __apache_php_fpm_handler in vars/main.yml: the placeholder URL
   belongs to a Unix socket only. See the comment there. #}
{% set __apache_fpm_socket = __apache_fpm_raw ~ '|fcgi://localhost' if (__apache_fpm_raw.startswith('unix:') and '|' not in __apache_fpm_raw) else __apache_fpm_raw %}
    <FilesMatch "\.php$">
        SetHandler "proxy:{{ __apache_fpm_socket }}"
    </FilesMatch>
{% endif %}
{% if not __apache_fpm_global or item.php_fpm_timeout is defined %}
    ProxyTimeout {{ item.php_fpm_timeout | default(apache_php_fpm_timeout) }}
{% endif %}
{% if not __apache_fpm_global or item.php_fpm_socket is defined or item.php_fpm_timeout is defined %}

{% endif %}
{% endif %}
