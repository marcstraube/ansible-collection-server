{{ ansible_managed | comment }}
{% set __nginx_http2_listen = ' http2' if not (__nginx_http2_directive | bool) and nginx_http2_enabled | bool else '' %}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

{% if nginx_acme_challenge_enabled | bool %}
{% include 'acme-challenge.conf.j2' %}
    location / {
        return {{ nginx_default_site_return }};
    }
{% else %}
    return {{ nginx_default_site_return }};
{% endif %}
}

server {
    listen 443 ssl{{ __nginx_http2_listen }} default_server;
    listen [::]:443 ssl{{ __nginx_http2_listen }} default_server;
{% if __nginx_http2_directive | bool and nginx_http2_enabled | bool %}
    http2 on;
{% endif %}
    server_name _;

{% if not (__nginx_default_site_self_signed | bool) %}
    ssl_certificate {{ nginx_default_site_ssl_certificate }};
    ssl_certificate_key {{ nginx_default_site_ssl_certificate_key }};
{% else %}
    # Auto-generated self-signed certificate
    ssl_certificate {{ __nginx_config_dir }}/ssl/default.crt;
    ssl_certificate_key {{ __nginx_config_dir }}/ssl/default.key;
{% endif %}

    return {{ nginx_default_site_return }};
}
