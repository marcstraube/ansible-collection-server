{{ ansible_managed | comment }}

{% for upstream in nginx_stream_upstreams %}
upstream {{ upstream.name }} {
{% for server in upstream.servers %}
    server {{ server.address }}{% if server.weight | default(1) != 1 %} weight={{ server.weight }}{% endif %}{% if server.backup | default(false) %} backup{% endif %};
{% endfor %}
}
{% endfor %}

{% for server in nginx_stream_servers %}
server {
    listen {{ server.listen }}{% if server.udp | default(false) %} udp{% endif %};
    proxy_pass {{ server.proxy_pass }};
{% if server.proxy_timeout is defined %}
    proxy_timeout {{ server.proxy_timeout }};
{% endif %}
{% if server.proxy_connect_timeout is defined %}
    proxy_connect_timeout {{ server.proxy_connect_timeout }};
{% endif %}
}
{% endfor %}
