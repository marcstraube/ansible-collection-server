{{ ansible_managed | comment }}

# Task runner launcher (n8nio/runners) for the n8n instance on this host

N8N_RUNNERS_TASK_BROKER_URI=http://127.0.0.1:{{ n8n_runners_broker_port }}
N8N_RUNNERS_AUTH_TOKEN={{ n8n_runners_auth_token }}
N8N_RUNNERS_MAX_CONCURRENCY={{ n8n_runners_max_concurrency }}
N8N_RUNNERS_TASK_TIMEOUT={{ n8n_runners_task_timeout }}
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT={{ n8n_runners_auto_shutdown_timeout }}
N8N_RUNNERS_LAUNCHER_LOG_LEVEL={{ n8n_runners_launcher_log_level }}
N8N_RUNNERS_LAUNCHER_HEALTH_CHECK_PORT={{ n8n_runners_health_check_port }}

# Timezone of the Code node, same as the n8n instance
GENERIC_TIMEZONE={{ n8n_timezone }}
{% if n8n_runners_node_function_allow_builtin | length > 0 %}

NODE_FUNCTION_ALLOW_BUILTIN={{ n8n_runners_node_function_allow_builtin }}
{% endif %}
{% if n8n_runners_node_function_allow_external | length > 0 %}
NODE_FUNCTION_ALLOW_EXTERNAL={{ n8n_runners_node_function_allow_external }}
{% endif %}
{% if n8n_runners_stdlib_allow | length > 0 %}
N8N_RUNNERS_STDLIB_ALLOW={{ n8n_runners_stdlib_allow }}
{% endif %}
{% if n8n_runners_external_allow | length > 0 %}
N8N_RUNNERS_EXTERNAL_ALLOW={{ n8n_runners_external_allow }}
{% endif %}
{% if n8n_http_proxy | length > 0 %}

# Outgoing Proxy

HTTP_PROXY={{ n8n_http_proxy }}
HTTPS_PROXY={{ n8n_https_proxy }}
{% if n8n_no_proxy | length > 0 %}
NO_PROXY={{ n8n_no_proxy }}
{% endif %}
{% endif %}
{% if n8n_runners_extra_env_vars %}

# Extra Environment Variables

{% for key, value in n8n_runners_extra_env_vars.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
