{{ ansible_managed | comment }}

# Network Configuration

N8N_HOST={{ n8n_host }}
N8N_PORT={{ n8n_port }}
N8N_PROTOCOL={{ n8n_protocol }}

{% if n8n_webhook_url | length > 0 %}
N8N_WEBHOOK_URL={{ n8n_webhook_url }}
{% endif %}
{% if n8n_editor_base_url | length > 0 %}
N8N_EDITOR_BASE_URL={{ n8n_editor_base_url }}
{% endif %}

# Database Configuration

DB_TYPE={{ n8n_db_type }}

{% if n8n_db_type == 'postgresdb' %}
DB_POSTGRESDB_HOST={{ n8n_db_host }}
DB_POSTGRESDB_PORT={{ n8n_db_port }}
DB_POSTGRESDB_DATABASE={{ n8n_db_name }}
DB_POSTGRESDB_USER={{ n8n_db_user }}
DB_POSTGRESDB_PASSWORD={{ n8n_db_password }}
{% if n8n_db_ssl | bool %}
DB_POSTGRESDB_SSL_ENABLED=true
{% endif %}
{% endif %}
{% if n8n_db_type in ['mysqldb', 'mariadb'] %}
DB_MYSQLDB_HOST={{ n8n_db_host }}
DB_MYSQLDB_PORT={{ n8n_db_port }}
DB_MYSQLDB_DATABASE={{ n8n_db_name }}
DB_MYSQLDB_USER={{ n8n_db_user }}
DB_MYSQLDB_PASSWORD={{ n8n_db_password }}
{% endif %}

# Security Configuration

N8N_ENCRYPTION_KEY={{ n8n_encryption_key }}

{% if n8n_basic_auth_enabled | bool %}
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER={{ n8n_basic_auth_user }}
N8N_BASIC_AUTH_PASSWORD={{ n8n_basic_auth_password }}
{% endif %}

N8N_SECURE_COOKIE={{ 'true' if n8n_secure_cookie else 'false' }}
N8N_JWT_SESSION_DURATION_HOURS={{ n8n_jwt_session_duration_hours }}
N8N_BLOCK_ENV_ACCESS_IN_NODE={{ 'true' if n8n_block_env_access_in_node else 'false' }}

{% if n8n_skip_webhook_deregistration_shutdown | bool %}
N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=true
{% endif %}

# Timezone and Localization

GENERIC_TIMEZONE={{ n8n_timezone }}
N8N_DEFAULT_LOCALE={{ n8n_default_locale }}

# Execution Settings

EXECUTIONS_MODE={{ n8n_executions_mode }}
EXECUTIONS_TIMEOUT={{ n8n_executions_timeout }}
EXECUTIONS_TIMEOUT_MAX={{ n8n_executions_timeout_max }}
EXECUTIONS_DATA_SAVE_ON_ERROR={{ n8n_executions_data_save_on_error }}
EXECUTIONS_DATA_SAVE_ON_SUCCESS={{ n8n_executions_data_save_on_success }}
EXECUTIONS_DATA_MAX_AGE={{ n8n_executions_data_max_age }}
EXECUTIONS_DATA_PRUNE={{ 'true' if n8n_executions_data_prune else 'false' }}

# Task Runners (launcher in n8n-runner.service)

N8N_RUNNERS_MODE=external
N8N_RUNNERS_AUTH_TOKEN={{ n8n_runners_auth_token }}
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=127.0.0.1
N8N_RUNNERS_BROKER_PORT={{ n8n_runners_broker_port }}
N8N_RUNNERS_MAX_CONCURRENCY={{ n8n_runners_max_concurrency }}
N8N_RUNNERS_TASK_TIMEOUT={{ n8n_runners_task_timeout }}

# Community Packages

N8N_UNVERIFIED_PACKAGES_ENABLED={{ 'true' if n8n_unverified_packages_enabled else 'false' }}

# Compression Node

N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES={{ n8n_compression_node_max_decompressed_size_bytes }}
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES={{ n8n_compression_node_max_zip_entries }}

# Workflow Settings

N8N_MANUAL_EXECUTION={{ 'true' if n8n_manual_execution else 'false' }}
WORKFLOWS_DEFAULT_NAME=My workflow

# Logging

N8N_LOG_LEVEL={{ n8n_log_level }}
N8N_LOG_OUTPUT={{ n8n_log_output }}

{% if 'file' in n8n_log_output %}
N8N_LOG_FILE_LOCATION={{ n8n_log_file_location }}
N8N_LOG_FILE_SIZE_MAX={{ n8n_log_file_max_size }}
N8N_LOG_FILE_COUNT_MAX={{ n8n_log_file_max_count }}
{% endif %}

# Telemetry and Updates

N8N_DIAGNOSTICS_ENABLED={{ 'true' if n8n_diagnostics_enabled else 'false' }}
N8N_HIDE_USAGE_PAGE={{ 'true' if n8n_hide_usage_page else 'false' }}
N8N_VERSION_NOTIFICATIONS_ENABLED={{ 'true' if n8n_version_notifications_enabled else 'false' }}

{% if n8n_otel_enabled | bool %}
# OpenTelemetry (n8n >= 2.15)

N8N_OTEL_ENABLED=true
N8N_OTEL_EXPORTER_OTLP_ENDPOINT={{ n8n_otel_exporter_otlp_endpoint }}
N8N_OTEL_EXPORTER_OTLP_TRACING_PATH={{ n8n_otel_exporter_otlp_tracing_path }}
{% if n8n_otel_exporter_otlp_headers | length > 0 %}
N8N_OTEL_EXPORTER_OTLP_HEADERS={{ n8n_otel_exporter_otlp_headers }}
{% endif %}
N8N_OTEL_EXPORTER_SERVICE_NAME={{ n8n_otel_exporter_service_name }}
N8N_OTEL_TRACES_SAMPLE_RATE={{ n8n_otel_traces_sample_rate }}
N8N_OTEL_STARTUP_CONNECTIVITY_TIMEOUT_MS={{ n8n_otel_startup_connectivity_timeout_ms }}
N8N_OTEL_TRACES_INCLUDE_NODE_SPANS={{ 'true' if n8n_otel_traces_include_node_spans else 'false' }}
N8N_OTEL_TRACES_INJECT_OUTBOUND={{ 'true' if n8n_otel_traces_inject_outbound else 'false' }}
N8N_OTEL_TRACES_PRODUCTION_ONLY={{ 'true' if n8n_otel_traces_production_only else 'false' }}

{% endif %}
{% if n8n_insights_max_age_days | string | length > 0 %}
# Insights (n8n >= 2.20)

N8N_INSIGHTS_MAX_AGE_DAYS={{ n8n_insights_max_age_days }}

{% endif %}
{% if (n8n_external_hook_files | length > 0)
   or (n8n_custom_extensions | length > 0)
   or (n8n_nodes_exclude | length > 0)
   or (n8n_nodes_include | length > 0) %}
# External Services

{% if n8n_external_hook_files | length > 0 %}
EXTERNAL_HOOK_FILES={{ n8n_external_hook_files }}
{% endif %}
{% if n8n_custom_extensions | length > 0 %}
N8N_CUSTOM_EXTENSIONS={{ n8n_custom_extensions }}
{% endif %}
{% if n8n_nodes_exclude | length > 0 %}
NODES_EXCLUDE={{ n8n_nodes_exclude }}
{% endif %}
{% if n8n_nodes_include | length > 0 %}
NODES_INCLUDE={{ n8n_nodes_include }}
{% endif %}

{% endif %}

# Endpoints

N8N_PATH={{ n8n_endpoints_rest }}
N8N_ENDPOINT_WEBHOOK={{ n8n_endpoints_webhook }}
N8N_ENDPOINT_WEBHOOK_TEST={{ n8n_endpoints_webhook_test }}
N8N_ENDPOINT_WEBHOOK_WAIT={{ n8n_endpoints_webhook_waiting }}

{% if n8n_disable_production_main_process | bool %}
N8N_DISABLE_PRODUCTION_MAIN_PROCESS=true
{% endif %}

{% if n8n_email_mode | length > 0 %}
# Email Settings

N8N_EMAIL_MODE={{ n8n_email_mode }}
N8N_SMTP_HOST={{ n8n_smtp_host }}
N8N_SMTP_PORT={{ n8n_smtp_port }}
N8N_SMTP_USER={{ n8n_smtp_user }}
N8N_SMTP_PASS={{ n8n_smtp_pass }}
N8N_SMTP_SENDER={{ n8n_smtp_sender }}
N8N_SMTP_SSL={{ 'true' if n8n_smtp_ssl else 'false' }}

{% endif %}
# User Management

N8N_USER_MANAGEMENT_DISABLED={{ 'true' if n8n_user_management_disabled else 'false' }}

{% if (n8n_behind_reverse_proxy | bool) or (n8n_trusted_proxy_ips | length > 0) %}
# Reverse Proxy

{% if n8n_behind_reverse_proxy | bool %}
N8N_METRICS=true
{% endif %}
{% if n8n_trusted_proxy_ips | length > 0 %}
N8N_PROXY_HOPS={{ n8n_trusted_proxy_ips }}
{% endif %}

{% endif %}
{% if n8n_http_proxy | length > 0 %}
# Outgoing Proxy

HTTP_PROXY={{ n8n_http_proxy }}
HTTPS_PROXY={{ n8n_https_proxy }}
{% if n8n_no_proxy | length > 0 %}
NO_PROXY={{ n8n_no_proxy }}
{% endif %}

{% endif %}
{% if n8n_extra_env_vars %}
# Extra Environment Variables

{% for key, value in n8n_extra_env_vars.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
