{{ ansible_managed | comment }}

# Network

AP_PORT={{ activepieces_port }}
AP_FRONTEND_URL={{ activepieces_frontend_url | regex_replace('/$', '') }}

# Security

AP_ENCRYPTION_KEY={{ activepieces_encryption_key }}
AP_JWT_SECRET={{ activepieces_jwt_secret }}

# Database

AP_DB_TYPE={{ activepieces_db_type }}
{% if activepieces_db_type == 'POSTGRES' %}
AP_POSTGRES_HOST={{ activepieces_db_host }}
AP_POSTGRES_PORT={{ activepieces_db_port }}
AP_POSTGRES_DATABASE={{ activepieces_db_name }}
AP_POSTGRES_USERNAME={{ activepieces_db_user }}
AP_POSTGRES_PASSWORD={{ activepieces_db_password }}
AP_POSTGRES_USE_SSL={{ activepieces_db_ssl | bool | lower }}
{% endif %}

# Queue: in memory, single instance without Redis

AP_REDIS_TYPE=MEMORY

# Execution

AP_ENVIRONMENT=prod
AP_EXECUTION_MODE={{ activepieces_execution_mode }}

# Telemetry

AP_TELEMETRY_ENABLED={{ activepieces_telemetry_enabled | bool | lower }}
{% if activepieces_extra_env %}

# Extra Environment Variables

{% for key, value in activepieces_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
