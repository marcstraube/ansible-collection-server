{{ ansible_managed | comment }}
server.host: "{{ wazuh_server_dashboard_server_host }}"
server.port: {{ wazuh_server_dashboard_server_port }}
opensearch.hosts: {{ __wazuh_server_indexer_url }}
opensearch.ssl.verificationMode: certificate
opensearch.ssl.certificateAuthorities: ["{{ __wazuh_server_dashboard_certs_dir }}/{{ __wazuh_server_ca_cert_name }}"]
opensearch.username: kibanaserver
opensearch.password: {{ wazuh_server_indexer_kibanaserver_password | to_json }}
opensearch.requestHeadersWhitelist: ["securitytenant","Authorization"]
opensearch_security.multitenancy.enabled: false
opensearch_security.readonly_mode.roles: ["kibana_read_only"]
server.ssl.enabled: true
server.ssl.key: "{{ __wazuh_server_dashboard_certs_dir }}/{{ __wazuh_server_dashboard_key_name }}"
server.ssl.certificate: "{{ __wazuh_server_dashboard_certs_dir }}/{{ __wazuh_server_dashboard_cert_name }}"
uiSettings.overrides.defaultRoute: {{ wazuh_server_dashboard_default_route | to_json }}
# Session expiration settings
opensearch_security.cookie.ttl: {{ wazuh_server_dashboard_session_ttl | int }}
opensearch_security.session.ttl: {{ wazuh_server_dashboard_session_ttl | int }}
opensearch_security.session.keepalive: {{ wazuh_server_dashboard_session_keepalive | bool | to_json }}
